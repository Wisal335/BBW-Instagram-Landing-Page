---
import Layout from "../layouts/Layout.astro";
import "../styles/style.css";
---

<Layout
    title="Free Digital Maturity Checklist | Big Brain Way"
    description="Find your business's digital maturity stage and see the next practical step."
    
>
    <main class="instagram-page">
        <div class="ambient ambient-one" aria-hidden="true"></div>
        <div class="ambient ambient-two" aria-hidden="true"></div>

        <div class="brand-mark">
            <img src="/image/BBW Logo.png" alt="Big Brain Way" width="180" height="auto" />
        </div>

        <!-- 01 — HERO -->
        <section class="hero" id="top">
            <div class="hero-grid" aria-hidden="true"></div>
            <div class="hero-orb hero-orb-one" aria-hidden="true"></div>
            <div class="hero-orb hero-orb-two" aria-hidden="true"></div>

            <div class="page-container hero-container">
                <div class="hero-content">
                    <div class="eyebrow reveal">
                        <span class="eyebrow-dot" aria-hidden="true"></span>
                        FREE DIGITAL MATURITY CHECKLIST
                    </div>

                    <h1 class="hero-title reveal reveal-delay-1">
                        <span>Your Business Is Already Digital.</span>
                        <strong>But How Intelligent Is It?</strong>
                    </h1>

                    <p class="hero-lead reveal reveal-delay-2">
                        Digital tools are everywhere. The question is whether
                        <strong> your business works smarter because of them.</strong>
                    </p>

                    <div
                        class="maturity-experience interactive-card reveal reveal-delay-3"
                        data-maturity-experience
                    >
                        <div class="card-glow" aria-hidden="true"></div>

                        <div class="experience-top">
                            <div>
                                <span class="mini-label">YOUR BUSINESS</span>
                                <strong data-stage-status>MANUAL</strong>
                            </div>
                            <div class="live-pill">
                                <span aria-hidden="true"></span>
                                LIVE
                            </div>
                        </div>

                        <div class="maturity-progress" aria-hidden="true">
                            <span data-progress-fill></span>
                        </div>

                        <div
                            class="maturity-rows"
                            role="group"
                            aria-label="Select your digital maturity stage"
                        >
                            <button type="button" class="maturity-row active" data-stage="1" aria-pressed="true">
                                <span class="stage-number">01</span>
                                <span class="stage-copy"><strong>Manual</strong><small>People + spreadsheets</small></span>
                                <span class="stage-state" data-stage-state>SELECTED</span>
                            </button>
                            <button type="button" class="maturity-row" data-stage="2" aria-pressed="false">
                                <span class="stage-number">02</span>
                                <span class="stage-copy"><strong>Digitized</strong><small>Tools in silos</small></span>
                                <span class="stage-state" data-stage-state></span>
                            </button>
                            <button type="button" class="maturity-row" data-stage="3" aria-pressed="false">
                                <span class="stage-number">03</span>
                                <span class="stage-copy"><strong>Connected</strong><small>Systems communicate</small></span>
                                <span class="stage-state" data-stage-state></span>
                            </button>
                            <button type="button" class="maturity-row" data-stage="4" aria-pressed="false">
                                <span class="stage-number">04</span>
                                <span class="stage-copy"><strong>Automated</strong><small>Workflows do more</small></span>
                                <span class="stage-state" data-stage-state></span>
                            </button>
                            <button type="button" class="maturity-row maturity-row-ai" data-stage="5" aria-pressed="false">
                                <span class="stage-number">05</span>
                                <span class="stage-copy"><strong>AI-Enabled</strong><small>Intelligence at scale</small></span>
                                <span class="ai-mark">AI</span>
                                <span class="stage-state" data-stage-state></span>
                            </button>
                        </div>

                        <div class="stage-detail" aria-live="polite">
                            <div class="stage-detail-number"><span data-detail-number>01</span></div>
                            <div class="stage-detail-content">
                                <span data-detail-label>MANUAL</span>
                                <strong data-detail-title>People are the system.</strong>
                                <p data-detail-description>Repetitive work depends on people, spreadsheets and manual handoffs.</p>
                                <div class="stage-signal">
                                    <span>SIGNAL</span>
                                    <em data-detail-signal>"Someone has to do this manually every time."</em>
                                </div>
                                <div class="stage-next">
                                    <span>NEXT</span>
                                    <strong data-detail-next>Identify repetitive work worth digitizing.</strong>
                                </div>
                            </div>
                        </div>

                        <div class="experience-footer">
                            <span>SELECT A STAGE TO EXPLORE</span>
                            <span aria-hidden="true">↗</span>
                        </div>
                    </div>

                    <a href="#checklist" class="primary-cta magnetic reveal reveal-delay-4">
                        <span>GET YOUR FREE CHECKLIST</span>
                        <b aria-hidden="true">→</b>
                    </a>

                    <div class="micro-proof reveal reveal-delay-5">
                        <span>✓ FREE</span>
                        <span>✓ 5 STAGES</span>
                        <span>✓ QUICK TO COMPLETE</span>
                    </div>
                </div>

                <div class="scroll-cue reveal" aria-hidden="true">
                    <span></span>
                    SEE THE PROBLEM
                </div>
            </div>
        </section>

        <!-- 02 — PAIN -->
        <section class="story-section problem-section" data-problem-experience>
            <div class="page-container">
                <div class="section-heading">

                    <span class="section-eyebrow reveal"><h2><strong>THE PAIN</strong></h2></span>
                    <h2 class="reveal">Digital tools don't fix<br /><span>broken workflows.</span></h2>
                    <p class="reveal">Three signs your business is working harder than it needs to.</p>
                </div>

                <div class="problem-experience reveal">
                    <div class="problem-tabs" role="group" aria-label="Explore common problems">
                        <button type="button" class="problem-tab active" data-problem="manual" aria-pressed="true">
                            <span>01</span>Too Much Manual Work
                        </button>
                        <button type="button" class="problem-tab" data-problem="systems" aria-pressed="false">
                            <span>02</span>Disconnected Systems
                        </button>
                        <button type="button" class="problem-tab" data-problem="decisions" aria-pressed="false">
                            <span>03</span>Slow Decisions
                        </button>
                    </div>

                    <div class="problem-story">
                        <div class="problem-visual">
                            <div class="flow-visual" data-problem-visual aria-hidden="true">
                                <div class="flow-node">TASK</div>
                                <div class="flow-line"></div>
                                <div class="flow-node">PERSON</div>
                                <div class="flow-line"></div>
                                <div class="flow-node warning-node">REPEAT</div>
                            </div>
                        </div>

                        <div class="problem-copy">
                            <div class="story-number"><span data-problem-number>01</span></div>
                            <span class="story-label">DATA STORY</span>
                            <h3 data-problem-title>Too Much Manual Work</h3>
                            <p data-problem-description>Repetitive tasks consume time that should go to customers and growth.</p>
                            <div class="story-outcome">
                                <span>OUTCOME</span>
                                <strong data-problem-outcome>Time gets trapped inside repetitive work.</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 03 — SOLUTION -->
        <section class="journey-section" data-stage-journey>
            <div class="page-container">
                <div class="section-heading">
                    <span class="section-eyebrow reveal"><h2><strong>THE SOLUTION</strong></h2></span>
                    <h2 class="reveal">Know where you are.<br /><span>Know what to fix next.</span></h2>
                    <p class="reveal">You don't need to jump straight to AI. Start with the next practical step.</p>
                </div>

                <div class="journey-layout reveal">
                    <div class="journey-track" role="group" aria-label="Explore the five maturity stages">
                        <div class="journey-line" aria-hidden="true"></div>
                        <button type="button" class="journey-card active" data-journey-stage="1" aria-pressed="true"><span>01</span><strong>Manual</strong><small>People + spreadsheets</small></button>
                        <button type="button" class="journey-card" data-journey-stage="2" aria-pressed="false"><span>02</span><strong>Digitized</strong><small>Tools in silos</small></button>
                        <button type="button" class="journey-card" data-journey-stage="3" aria-pressed="false"><span>03</span><strong>Connected</strong><small>Systems communicate</small></button>
                        <button type="button" class="journey-card" data-journey-stage="4" aria-pressed="false"><span>04</span><strong>Automated</strong><small>Workflows do more</small></button>
                        <button type="button" class="journey-card journey-card-ai" data-journey-stage="5" aria-pressed="false"><span>05</span><strong>AI-Enabled</strong><small>Intelligence at scale</small></button>
                    </div>

                    <div class="journey-detail">
                        <div class="journey-detail-index"><span data-journey-number>01</span></div>
                        <div>
                            <span class="story-label">STAGE INSIGHT</span>
                            <h3 data-journey-title>People are still holding the system together.</h3>
                            <p data-journey-description>Start by identifying repetitive work and manual handoffs.</p>
                        </div>
                    </div>
                </div>

                <div class="solution-benefits">
                    <article class="value-card reveal">
                        <div class="value-visual"><img src="/media/stage-loop.gif" alt="" loading="lazy" decoding="async" /></div>
                        <span class="value-index">01</span>
                        <h3>Identify your stage</h3>
                        <p>See your current maturity without the jargon.</p>
                    </article>
                    <article class="value-card reveal reveal-delay-1">
                        <div class="value-visual"><img src="/media/gaps-loop.gif" alt="" loading="lazy" decoding="async" /></div>
                        <span class="value-index">02</span>
                        <h3>Find your gaps</h3>
                        <p>Spot friction, silos and repetitive work.</p>
                    </article>
                    <article class="value-card reveal reveal-delay-2">
                        <div class="value-visual"><img src="/media/next-loop.gif" alt="" loading="lazy" decoding="async" /></div>
                        <span class="value-index">03</span>
                        <h3>See your next move</h3>
                        <p>Focus on one practical improvement at a time.</p>
                    </article>
                </div>
            </div>
        </section>

        <!-- 04 — CTA -->
        <section class="checklist-section" id="checklist">
            <div class="checklist-grid" aria-hidden="true"></div>
            <div class="checklist-glow" aria-hidden="true"></div>

            <div class="page-container checklist-container">
                <div class="checklist-preview reveal">
                    <div class="preview-top"><span>BIG BRAIN WAY</span><span>FREE RESOURCE</span></div>
                    <div class="preview-title">
                        <span>5-STAGE</span><strong>DIGITAL MATURITY</strong><span>CHECKLIST</span>
                    </div>
                    <div class="mini-stage-track">
                        <span>01</span><i></i><span>02</span><i></i><span>03</span><i></i><span>04</span><i></i><span>05</span>
                    </div>
                </div>

                <div class="section-eyebrow reveal">FREE INSTANT ACCESS</div>
                <h2 class="reveal">Discover Your <span>Digital Maturity.</span></h2>
                <p class="form-intro reveal">Get the free checklist and see what deserves attention next.</p>

                <div class="form-benefits reveal">
                    <span>5 STAGES</span><i aria-hidden="true"></i>
                    <span>QUICK TO COMPLETE</span><i aria-hidden="true"></i>
                    <span>100% FREE</span>
                </div>

                <form
                    id="leadForm"
                    name="digital-maturity-checklist"
                    method="POST"
                    action="/"
                    data-netlify="true"
                    data-netlify-honeypot="bot-field"
                    netlify-honeypot="bot-field"
                    novalidate
                >
                    <input type="hidden" name="Form-Name" value="Digital-Maturity-Checklist" />
                    <input type="hidden" name="Source" value="Instagram" />
                    <input type="hidden" name="Selected_Stage" id="selectedStage" value="1" />

                    <p class="honeypot">
                        <label>Don't fill this out if you're human:
                            <input name="bot-field" tabindex="-1" autocomplete="off" />
                        </label>
                    </p>

                    <div class="input-group">
                        <label for="name">NAME</label>
                        <div class="input-shell">
                            <span class="input-symbol" aria-hidden="true">→</span>
                            <input id="name" name="name" type="text" autocomplete="given-name" placeholder="Enter your name" minlength="2" maxlength="60" required aria-describedby="name-error" />
                        </div>
                        <small id="name-error" class="field-error" aria-live="polite"></small>
                    </div>

                    <div class="input-group">
                        <label for="contact">WHATSAPP / EMAIL</label>
                        <div class="input-shell">
                            <span class="input-symbol" aria-hidden="true">@</span>
                            <input id="contact" name="contact" type="text" autocomplete="email" inputmode="email" placeholder="Enter your Email or WhatsApp number" required aria-describedby="contact-error" />
                        </div>
                        <small id="contact-error" class="field-error" aria-live="polite"></small>
                    </div>

                    <button type="submit" class="form-button magnetic">
                        <span>GET YOUR FREE CHECKLIST</span><b aria-hidden="true">→</b>
                    </button>

                    <div id="formMessage" class="form-message" role="status" aria-live="polite"></div>
                </form>

                <p class="privacy-text reveal">🔒 No spam. No obligation. Just clarity.</p>

                <div class="delivery-note reveal">
                    <span aria-hidden="true">✓</span>
                    <p>Your information is used to deliver your checklist and relevant follow-up.</p>
                </div>
            </div>
        </section>

    </main>

    <button id="backToTop" class="back-to-top" type="button" aria-label="Back to top">↑</button>

    <script>
        import "../scripts/script.js";
    </script>
</Layout>
