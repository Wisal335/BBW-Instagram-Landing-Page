---
import Layout from "../layouts/Layout.astro";
import "../styles/style.css";
---

<Layout
    title="Free Digital Maturity Checklist | Big Brain Way"
    description="Discover your business's digital maturity stage and identify your next best move with Big Brain Way's free 5-Stage Digital Maturity Checklist."
>

    <main class="instagram-page">

        <!-- =====================================================
             AMBIENT PAGE LIGHT
        ====================================================== -->

        <div class="page-orb page-orb-one"></div>
        <div class="page-orb page-orb-two"></div>


        <!-- =====================================================
             BRAND
        ====================================================== -->

        <header class="brand-strip">

            <div class="brand-grid"></div>

            <div class="brand-light"></div>

            <img
                src="/image/BBW Logo.png"
                alt="Big Brain Way"
                class="brand-logo"
            />

        </header>


        <!-- =====================================================
             HERO
        ====================================================== -->

        <section
            class="ig-hero"
            id="home"
        >

            <div class="hero-grid"></div>

            <div class="hero-noise"></div>

            <div class="hero-glow hero-glow-one"></div>
            <div class="hero-glow hero-glow-two"></div>
            <div class="hero-glow hero-glow-three"></div>

            <div class="hero-content">

                <div class="eyebrow reveal">

                    <span class="eyebrow-dot"></span>

                    DIGITAL MATURITY CHECKLIST

                </div>


                <h1 class="hero-title reveal reveal-delay-1">

                    <span class="headline-glow">
                     Your Business Is Already Digital.
                    </span>

                    <strong>
                        But How Intelligent Is It?
                    </strong>

                </h1>


                <p class="hero-lead reveal reveal-delay-2">

                    Most businesses don't have a technology problem.<br>

                    <span class="hero-lead-break">
                        They have a digital maturity problem.
                    </span>

                </p>


                <!-- =================================================
                     MATURITY EXPERIENCE
                ================================================== -->

                <div
                    class="maturity-preview interactive-card reveal reveal-delay-3"
                    data-tilt
                >

                    <div class="card-light"></div>

                    <div class="preview-header">

                        <span>
                            YOUR DIGITAL MATURITY
                        </span>

                        <span class="live-indicator">
                            <i></i>
                            LIVE
                        </span>

                    </div>


                    <div class="maturity-progress">

                        <span class="progress-fill"></span>

                    </div>


                    <button
                        class="maturity-row active"
                        type="button"
                        data-stage="1"
                        aria-label="Stage 1: Manual"
                    >

                        <span class="stage-number">
                            01
                        </span>

                        <div>
                            <strong>Manual</strong>

                            <small>
                                People + spreadsheets
                            </small>
                        </div>

                        <span class="stage-state">
                            CURRENT
                        </span>

                    </button>


                    <button
                        class="maturity-row"
                        type="button"
                        data-stage="2"
                        aria-label="Stage 2: Digitized"
                    >

                        <span class="stage-number">
                            02
                        </span>

                        <div>
                            <strong>Digitized</strong>

                            <small>
                                Tools in silos
                            </small>
                        </div>

                    </button>


                    <button
                        class="maturity-row"
                        type="button"
                        data-stage="3"
                        aria-label="Stage 3: Connected"
                    >

                        <span class="stage-number">
                            03
                        </span>

                        <div>
                            <strong>Connected</strong>

                            <small>
                                Systems communicate
                            </small>
                        </div>

                    </button>


                    <button
                        class="maturity-row"
                        type="button"
                        data-stage="4"
                        aria-label="Stage 4: Automated"
                    >

                        <span class="stage-number">
                            04
                        </span>

                        <div>
                            <strong>Automated</strong>

                            <small>
                                Intelligent workflows
                            </small>
                        </div>

                    </button>


                    <button
                        class="maturity-row ai-row"
                        type="button"
                        data-stage="5"
                        aria-label="Stage 5: AI-Enabled"
                    >

                        <span class="stage-number">
                            05
                        </span>

                        <div>
                            <strong>AI-Enabled</strong>

                            <small>
                                Intelligence at scale
                            </small>
                        </div>

                        <span class="ai-badge">
                            AI
                        </span>

                    </button>


                    <div class="preview-footer">

                        <span>
                            YOUR NEXT STEP STARTS WITH KNOWING WHERE YOU ARE.
                        </span>

                    </div>

                </div>


                <!-- =================================================
                     PRIMARY CTA
                ================================================== -->

                <a
                    href="#checklist"
                    class="primary-cta magnetic reveal reveal-delay-4"
                >

                    <span>
                        GET YOUR FREE CHECKLIST
                    </span>

                    <b>
                        →
                    </b>

                </a>


                <div class="micro-proof reveal reveal-delay-5">

                    <span>
                        ✓ FREE
                    </span>

                    <span>
                        ✓ 5 STAGES
                    </span>

                    <span>
                        ✓ NO OBLIGATION
                    </span>

                </div>

            </div>

            <div class="hero-scroll-hint">

                <span></span>

                SCROLL TO EXPLORE

            </div>

        </section>


        <!-- =====================================================
             PROBLEM
        ====================================================== -->

        <section class="problem-section">

            <div class="section-inner">

                <div class="section-eyebrow reveal">
                    THE REAL PROBLEM
                </div>


                <h2 class="reveal">

                    Having digital tools
                    <span>doesn't make your business digital.</span>

                </h2>


                <p class="section-intro reveal">

                    You can have dozens of apps, dashboards, and
                    subscriptions and still run your business manually.

                    <strong>
                        The problem isn't how many tools you have.
                        It's how well they work together.
                    </strong>

                </p>


                <div class="problem-stack">

                    <article
                        class="problem-card interactive-card reveal"
                        data-tilt
                    >

                        <div class="card-light"></div>

                        <span class="problem-icon">
                            01
                        </span>

                        <div>

                            <strong>
                                Too Much Manual Work
                            </strong>

                            <p>
                                Repetitive tasks consume time your
                                team should spend on customers,
                                growth, and higher-value work.
                            </p>

                        </div>

                    </article>


                    <article
                        class="problem-card interactive-card reveal"
                        data-tilt
                    >

                        <div class="card-light"></div>

                        <span class="problem-icon">
                            02
                        </span>

                        <div>

                            <strong>
                                Disconnected Systems
                            </strong>

                            <p>
                                Your tools collect valuable data,
                                but the information stays trapped
                                in separate systems.
                            </p>

                        </div>

                    </article>


                    <article
                        class="problem-card interactive-card reveal"
                        data-tilt
                    >

                        <div class="card-light"></div>

                        <span class="problem-icon">
                            03
                        </span>

                        <div>

                            <strong>
                                Slow Decisions
                            </strong>

                            <p>
                                Important decisions depend on
                                scattered information, delayed
                                reports, and too much guesswork.
                            </p>

                        </div>

                    </article>

                </div>


                <div class="section-transition reveal">

                    <span class="transition-line"></span>

                    <span>
                        SO WHAT COMES NEXT?
                    </span>

                    <span class="transition-line"></span>

                </div>

            </div>

        </section>


        <!-- =====================================================
             FIVE STAGES
        ====================================================== -->

        <section class="stages-section">

            <div class="section-inner">

                <div class="section-eyebrow reveal">
                    THE 5-STAGE MODEL
                </div>


                <h2 class="reveal">

                    Know where you are.
                    <span>Know what comes next.</span>

                </h2>


                <p class="section-intro reveal">

                    Your business doesn't need to jump straight to AI.

                    <span class="copy-break">
                        It needs to understand its next step.
                    </span>

                </p>


                <div class="stage-list">

                    <div class="stage-connection"></div>


                    <article
                        class="stage-card interactive-card reveal"
                        data-tilt
                        data-stage-card="1"
                    >

                        <span class="stage-index">
                            01
                        </span>

                        <div>
                            <strong>Manual</strong>

                            <p>
                                People and spreadsheets hold
                                everything together.
                            </p>
                        </div>

                        <span class="stage-arrow">
                            →
                        </span>

                    </article>


                    <article
                        class="stage-card interactive-card reveal"
                        data-tilt
                        data-stage-card="2"
                    >

                        <span class="stage-index">
                            02
                        </span>

                        <div>
                            <strong>Digitized</strong>

                            <p>
                                Digital tools exist, but they
                                still work in silos.
                            </p>
                        </div>

                        <span class="stage-arrow">
                            →
                        </span>

                    </article>


                    <article
                        class="stage-card interactive-card reveal"
                        data-tilt
                        data-stage-card="3"
                    >

                        <span class="stage-index">
                            03
                        </span>

                        <div>
                            <strong>Connected</strong>

                            <p>
                                Systems communicate and data
                                begins to flow between them.
                            </p>
                        </div>

                        <span class="stage-arrow">
                            →
                        </span>

                    </article>


                    <article
                        class="stage-card interactive-card reveal"
                        data-tilt
                        data-stage-card="4"
                    >

                        <span class="stage-index">
                            04
                        </span>

                        <div>
                            <strong>Automated</strong>

                            <p>
                                Workflows reduce repetitive
                                human effort and improve consistency.
                            </p>
                        </div>

                        <span class="stage-arrow">
                            →
                        </span>

                    </article>


                    <article
                        class="stage-card stage-ai interactive-card reveal"
                        data-tilt
                        data-stage-card="5"
                    >

                        <span class="stage-index">
                            05
                        </span>

                        <div>
                            <strong>AI-Enabled</strong>

                            <p>
                                Intelligence helps you predict,
                                decide, and scale.
                            </p>
                        </div>

                        <b>
                            AI
                        </b>

                    </article>

                </div>


                <div class="stage-insight reveal">

                    <span class="insight-pulse"></span>

                    <p>
                        The goal isn't to become "more digital."
                        The goal is to make your business
                        <strong> smarter, faster, and easier to scale.</strong>
                    </p>

                </div>

            </div>

        </section>


        <!-- =====================================================
             VALUE
        ====================================================== -->

        <section class="value-section">

            <div class="value-orb"></div>

            <div class="section-inner">

                <div class="section-eyebrow reveal">
                    WHAT YOU GET
                </div>


                <h2 class="reveal">

                    Stop guessing.
                    <span>Start with clarity.</span>

                </h2>


                <p class="section-intro reveal">

                    The free checklist gives you a simple way
                    to understand where your business stands
                    and what deserves attention next.

                </p>


                <div class="value-list">

                    <article
                        class="value-item interactive-card reveal"
                        data-tilt
                    >

                        <span class="value-number">
                            01
                        </span>

                        <div>

                            <strong>
                                Identify Your Stage
                            </strong>

                            <p>
                                Understand your current digital
                                maturity level without complicated jargon.
                            </p>

                        </div>

                        <span class="value-check">
                            ✓
                        </span>

                    </article>


                    <article
                        class="value-item interactive-card reveal"
                        data-tilt
                    >

                        <span class="value-number">
                            02
                        </span>

                        <div>

                            <strong>
                                Find Your Gaps
                            </strong>

                            <p>
                                Spot manual work, disconnected systems,
                                and operational friction holding you back.
                            </p>

                        </div>

                        <span class="value-check">
                            ✓
                        </span>

                    </article>


                    <article
                        class="value-item interactive-card reveal"
                        data-tilt
                    >

                        <span class="value-number">
                            03
                        </span>

                        <div>

                            <strong>
                                See Your Next Move
                            </strong>

                            <p>
                                Focus on the next practical improvement
                                instead of trying to fix everything at once.
                            </p>

                        </div>

                        <span class="value-check">
                            ✓
                        </span>

                    </article>

                </div>


                <div class="clarity-message reveal">

                    <span class="clarity-line"></span>

                    <p>
                        You don't need another complicated strategy.
                    </p>

                    <strong>
                        You need to know what to do next.
                    </strong>

                </div>

            </div>

        </section>


        <!-- =====================================================
             FINAL LEAD CAPTURE
        ====================================================== -->

        <section
            class="checklist-section"
            id="checklist"
        >

            <div class="cta-grid"></div>

            <div class="cta-glow"></div>
            <div class="cta-glow cta-glow-two"></div>

            <div class="form-wrapper">

                <div class="section-eyebrow reveal">
                    FREE INSTANT ACCESS
                </div>


                <h2 class="reveal">

                    Discover Your
                    <span>Digital Maturity.</span>

                </h2>


                <p class="form-intro reveal">

                    Take the first step toward a smarter business.

                    Get the free 5-Stage Digital Maturity Checklist
                    and discover what your business should improve next.

                </p>


                <div class="form-benefit-strip reveal">

                    <span>
                        5 STAGES
                    </span>

                    <i></i>

                    <span>
                        QUICK TO COMPLETE
                    </span>

                    <i></i>

                    <span>
                        100% FREE
                    </span>

                </div>


                <form
                    id="leadForm"
                    novalidate
                >

                    <div class="input-group">

                        <label for="name">
                            FIRST NAME
                        </label>

                        <div class="input-shell">

                            <span class="input-icon">
                                →
                            </span>

                            <input
                                id="name"
                                type="text"
                                name="name"
                                autocomplete="given-name"
                                placeholder="Enter your first name"
                                required
                            />

                        </div>

                        <small class="field-error"></small>

                    </div>


                    <div class="input-group">

                        <label for="contact">
                            WHATSAPP OR EMAIL
                        </label>

                        <div class="input-shell">

                            <span class="input-icon">
                                @
                            </span>

                            <input
                                id="contact"
                                type="text"
                                name="contact"
                                autocomplete="email"
                                inputmode="email"
                                placeholder="Email or WhatsApp number"
                                required
                            />

                        </div>

                        <small class="field-error"></small>

                    </div>


                    <button
                        type="submit"
                        class="form-button magnetic"
                    >

                        <span>
                            GET YOUR FREE CHECKLIST
                        </span>

                        <b>
                            →
                        </b>

                    </button>


                    <div
                        id="formMessage"
                        class="form-message"
                        role="status"
                        aria-live="polite"
                    ></div>

                </form>


                <p class="privacy-text">

                    🔒 No spam. No obligation. Just clarity.

                </p>


                <div class="final-reassurance reveal">

                    <span>✓</span>

                    <p>
                        Your information is used only to provide
                        your checklist and relevant follow-up.
                    </p>

                </div>

            </div>

        </section>

    </main>


    <!-- =====================================================
         BACK TO TOP
    ====================================================== -->

    <button
        id="backToTop"
        class="back-to-top"
        aria-label="Back to top"
        type="button"
    >
        ↑
    </button>


    <script>
        import "../scripts/script.js";
    </script>

</Layout>